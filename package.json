{
  "name": "enblanco-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern 'studio/**' --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/smoke.mjs",
    "studio": "node scripts/copy-env-for-studio.js && cd studio && npm run dev",
    "sanity:typegen": "cd studio && npx sanity schema extract --path schema.json && npx sanity typegen generate",
    "check:project-assets": "node scripts/check-project-asset-sizes.js",
    "check:assets": "node scripts/check-project-assets.mjs",
    "convert:assets": "node scripts/convert-project-images.mjs"
  },
  "dependencies": {
    "@sanity/client": "^7.6.0",
    "@sanity/image-url": "^1.0.2",
    "framer-motion": "^12.34.5",
    "groq": "^3.0.0",
    "next": "15.5.9",
    "next-sanity": "9.12.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "resend": "^6.9.3",
    "styled-components": "^6.1.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^9",
    "eslint-config-next": "15.5.9",
    "sanity": "^3.69.0",
    "sharp": "^0.33.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
